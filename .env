# UptimeRobot API Key
VITE_UPTIMEROBOT_API_KEY = "xxxx"

# UptimeRobot API URL
# 本地开发可填 https://api.uptimerobot.com/v3 直连；部署用 /api/status 走代理
VITE_UPTIMEROBOT_API_URL = "/api/status"

# 站点名称
VITE_APP_TITLE = "Status Page By 山人"

# 监控列表默认排序字段
# 支持 friendly_name、create_datetime 和 status
VITE_UPTIMEROBOT_STATUS_SORT = "create_datetime"

# 自定义域名顺序（可选）
# 配置后的域名会按此顺序置顶，其余项目使用页面选择的排序方式
# 多个地址用逗号分隔，支持完整 URL 或域名
VITE_CUSTOM_DOMAIN_ORDER = "https://www.1949101.xyz,https://drive.1949101.xyz,https://status.1949101.xyz,https://news.1949101.xyz,https://image.1949101.xyz,https://image-beta.1949101.xyz"